local Mission = require("../src/shared/Mission")
local D = require("../src/shared/Decorations")
local s, d = Mission.new(), D.new()
assert(not D.place(s, d, 1), "Cannot decorate before painting")
assert(not D.buy(s, d, "fake"))
assert(D.buy(s, d, "chair"))
assert(s.cash == 50 and d.inventory.chair == 1)
assert(not D.buy(s, d, "chair"), "Cannot overspend")
assert(s.cash == 50 and d.inventory.chair == 1)
assert(not D.select(d, "fake", "sage"))
assert(not D.select(d, "chair", "fake"))
assert(not D.select(d, "shelf", "rose"), "Must own selection")
s.stage = 3
assert(D.select(d, "chair", "rose"))
assert(D.place(s, d, 1))
assert(d.inventory.chair == 0)
assert(not D.place(s, d, 2), "No extra free copies")
assert(D.select(d, "chair", "ocean") and D.place(s, d, 1), "Recolor installed furniture")
assert(d.slots[1].color == "ocean" and d.inventory.chair == 0)
assert(D.select(d, "plant", "sage") and D.place(s, d, 1))
assert(d.inventory.chair == 1 and d.inventory.plant == 2, "Replacement returns old furniture")
assert(not D.place(s, d, 0) and not D.place(s, d, 4) and not D.place(s, d, 1.5))
assert(Mission.apply(s, 3, "decor1"))
assert(D.place(s, d, 1) and not Mission.apply(s, 3, "decor1"), "Editing cannot farm XP")
assert(D.place(s, d, 2) and Mission.apply(s, 3, "decor2"))
assert(D.place(s, d, 3) and Mission.apply(s, 3, "decor3"))
assert(s.completed and d.inventory.plant == 0, "Starter kit can finish without purchases")
assert(D.select(d, "chair", "sand") and D.place(s, d, 2), "Can redesign after completion")
assert(D.new().inventory.plant == 3, "Inventories are independent")
d.inventory.plant = 30
assert(not D.buy(s, d, "plant"), "Inventory cap")
print("PASS: purchases, funds, ownership, colors, inventory, replacement, completion and no duplicate rewards")
