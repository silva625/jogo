      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Catalog</string>
          <string name="Source"><![CDATA[local Catalog = {}
Catalog.colors = {
	{ id = "rose", name = "Rosa", rgb = {220, 145, 179} },
	{ id = "sage", name = "Verde", rgb = {128, 162, 132} },
	{ id = "sand", name = "Areia", rgb = {205, 183, 146} },
	{ id = "ocean", name = "Azul", rgb = {107, 150, 185} },
}
Catalog.items = {
	{ id = "plant", name = "Planta de interior", category = "Plantas", price = 75, description = "Um toque de verde para a casa." },
	{ id = "lamp", name = "Luminária de piso", category = "Luzes", price = 120, description = "Luz quente e ambiente acolhedor." },
	{ id = "rug", name = "Tapete redondo", category = "Tapetes", price = 100, description = "Cor e conforto em cada cantinho." },
	{ id = "table", name = "Mesa lateral", category = "Móveis", price = 150, description = "Madeira natural e linhas simples." },
	{ id = "chair", name = "Poltrona aconchego", category = "Móveis", price = 200, description = "Seu novo lugar favorito." },
	{ id = "shelf", name = "Estante de livros", category = "Móveis", price = 180, description = "Livros, objetos e personalidade." },
	{ id = "frame", name = "Quadro com cavalete", category = "Decoração", price = 160, description = "Uma paisagem para deixar a sala acolhedora." },
	{ id = "vase", name = "Vaso de flores", category = "Decoração", price = 110, description = "Cerâmica e flores para um toque natural." },
	{ id = "clock", name = "Relógio decorativo", category = "Decoração", price = 140, description = "Madeira e detalhes discretos." },
}
function Catalog.find(id)
	for _, item in Catalog.items do if item.id == id then return item end end
	return nil
end
function Catalog.color(id)
	for _, color in Catalog.colors do if color.id == id then return color end end
	return nil
end
return Catalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Decorations</string>
          <string name="Source"><![CDATA[local Catalog = if script then require(script.Parent.Catalog) else require("./Catalog")
local Decorations = {}
function Decorations.new()
	return { inventory = { plant = 3 }, selected = "plant", color = "sage", slots = {} }
end
function Decorations.buy(state, decor, id)
	local item = Catalog.find(id)
	if not item then return false, "Item inválido." end
	local total = 0
	for _, count in decor.inventory do total += count end
	if total >= 30 then return false, "Mochila cheia (30 itens). Coloque alguns na casa." end
	if state.cash < item.price then return false, "Dinheiro insuficiente. Continue a reforma!" end
	state.cash -= item.price
	decor.inventory[id] = (decor.inventory[id] or 0) + 1
	return true, "Compra realizada: " .. item.name
end
function Decorations.select(decor, id, color)
	if not Catalog.find(id) or not Catalog.color(color) then return false, "Escolha inválida." end
	if (decor.inventory[id] or 0) == 0 then
		-- Allow recoloring an item already installed without buying another copy.
		local installed = false
		for _, slot in decor.slots do if slot.id == id then installed = true end end
		if not installed then return false, "Compre esse item primeiro." end
	end
	decor.selected, decor.color = id, color
	return true, "Selecionado! Segure E em um ponto rosa da sua casa."
end
function Decorations.place(state, decor, slot)
	if state.stage < 3 then return false, "Termine a limpeza e a pintura primeiro." end
	if type(slot) ~= "number" or slot % 1 ~= 0 or slot < 1 or slot > 3 then return false, "Ponto inválido." end
	local old = decor.slots[slot]
	local id = decor.selected
	if not Catalog.find(id) or not Catalog.color(decor.color) then return false, "Escolha inválida." end
	if not old or old.id ~= id then
		if (decor.inventory[id] or 0) < 1 then return false, "Sem unidades na mochila. Escolha outro item ou compre na loja." end
		decor.inventory[id] -= 1
		if old then decor.inventory[old.id] = (decor.inventory[old.id] or 0) + 1 end
	end
	decor.slots[slot] = { id = id, color = decor.color }
	return true, old and "Decoração atualizada. O item anterior voltou à mochila." or "Decoração colocada!"
end
return Decorations
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Furniture</string>
          <string name="Source"><![CDATA[-- Same native geometry powers the catalog previews and placed items.
local Catalog = require(script.Parent.Catalog)
local Furniture = {}
function Furniture.create(id, colorId, origin)
	local palette = Catalog.color(colorId) or Catalog.colors[1]
	local color = Color3.fromRGB(table.unpack(palette.rgb))
	local wood = Color3.fromRGB(143, 104, 75)
	local dark = Color3.fromRGB(49, 53, 57)
	local model = Instance.new("Model")
	model.Name = id
	local function p(name, size, position, tint, material, shape)
		local part = Instance.new("Part")
		part.Name, part.Size = name, size
		part.CFrame = origin * CFrame.new(position)
		part.Color = tint
		part.Material = material or Enum.Material.SmoothPlastic
		part.Anchored = true
		part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		if shape then part.Shape = shape end
		part.Parent = model
		return part
	end
	if id == "plant" then
		p("Vaso", Vector3.new(1.8, 1.7, 1.8), Vector3.new(0, .85, 0), color)
		p("Caule", Vector3.new(.18, 2, .18), Vector3.new(0, 2.5, 0), wood)
		for i = 1, 3 do
			p("Folhas", Vector3.new(2.1, 1.5, 2.1), Vector3.new((i - 2) * .55, 2.6 + i * .35, 0), Color3.fromRGB(68, 126, 80), Enum.Material.Grass, Enum.PartType.Ball)
		end
	elseif id == "lamp" then
		p("Base", Vector3.new(1.6, .25, 1.6), Vector3.new(0, .125, 0), dark)
		p("Haste", Vector3.new(.18, 4, .18), Vector3.new(0, 2.1, 0), wood)
		local shade = p("Cúpula", Vector3.new(2, 1.4, 2), Vector3.new(0, 4.2, 0), color, Enum.Material.Neon)
		local light = Instance.new("PointLight", shade)
		light.Color, light.Brightness, light.Range = Color3.fromRGB(255, 219, 170), 1, 15
	elseif id == "rug" then
		local rug = p("Tapete", Vector3.new(.12, 4.5, 4.5), Vector3.new(0, .08, 0), color, Enum.Material.Fabric, Enum.PartType.Cylinder)
		rug.CFrame *= CFrame.Angles(0, 0, math.pi / 2)
		rug.CanCollide = false
	elseif id == "table" then
		p("Tampo", Vector3.new(3.2, .35, 2.6), Vector3.new(0, 2.4, 0), color)
		for _, x in {-1.2, 1.2} do for _, z in {-.9, .9} do
			p("Pé", Vector3.new(.25, 2.3, .25), Vector3.new(x, 1.15, z), wood, Enum.Material.Wood)
		end end
	elseif id == "chair" then
		p("Assento", Vector3.new(3.2, .8, 2.9), Vector3.new(0, 1.25, 0), color, Enum.Material.Fabric)
		p("Encosto", Vector3.new(3.2, 2.5, .6), Vector3.new(0, 2.3, -1.2), color, Enum.Material.Fabric)
		for _, x in {-1.5, 1.5} do
			p("Braço", Vector3.new(.45, 1.4, 3), Vector3.new(x, 1.9, 0), color, Enum.Material.Fabric)
			for _, z in {-1, 1} do p("Pé", Vector3.new(.3, .85, .3), Vector3.new(x, .425, z), wood) end
		end
	elseif id == "frame" then
		p("Apoio", Vector3.new(1.8, .2, 1.6), Vector3.new(0, .1, 0), wood)
		p("Cavalete", Vector3.new(.25, 2.1, .3), Vector3.new(0, 1.1, 0), wood)
		p("Moldura", Vector3.new(2.5, 2, .25), Vector3.new(0, 2.4, 0), wood)
		p("Tela", Vector3.new(2.15, 1.65, .04), Vector3.new(0, 2.4, .15), Color3.fromRGB(186, 200, 202))
		p("Paisagem", Vector3.new(2.15, .6, .06), Vector3.new(0, 1.95, .18), color)
	elseif id == "vase" then
		p("Vaso cerâmico", Vector3.new(1.6, 2, 1.6), Vector3.new(0, 1, 0), color)
		for i = 1, 5 do
			local x, z = math.cos(i * 1.26) * .5, math.sin(i * 1.26) * .5
			p("Haste da flor", Vector3.new(.06, 1.5, .06), Vector3.new(x, 2.5, z), Color3.fromRGB(90, 121, 70))
			p("Flor", Vector3.new(.65, .4, .65), Vector3.new(x, 3.3, z), Color3.fromRGB(230, 209, 172), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		end
	elseif id == "clock" then
		p("Pedestal", Vector3.new(2.2, .3, 1.3), Vector3.new(0, .15, 0), wood)
		p("Base do relógio", Vector3.new(1.5, 1, 1), Vector3.new(0, .8, 0), wood)
		p("Caixa do relógio", Vector3.new(2.1, 2.1, .55), Vector3.new(0, 2.1, 0), color)
		p("Mostrador", Vector3.new(1.8, 1.8, .06), Vector3.new(0, 2.1, .32), Color3.fromRGB(236, 229, 213))
		p("Ponteiro de horas", Vector3.new(.09, .55, .05), Vector3.new(0, 2.35, .37), dark)
		p("Ponteiro de minutos", Vector3.new(.65, .07, .05), Vector3.new(.3, 2.1, .37), dark)
	elseif id == "shelf" then
		for _, x in {-1.4, 1.4} do p("Lateral", Vector3.new(.25, 4.8, 1.3), Vector3.new(x, 2.4, 0), wood) end
		for level = 0, 3 do
			p("Prateleira", Vector3.new(3, .2, 1.4), Vector3.new(0, .15 + level * 1.5, 0), color)
			if level < 3 then for book = 1, 4 do
				p("Livro", Vector3.new(.3, .9, .8), Vector3.new(-.9 + book * .4, .7 + level * 1.5, 0), book % 2 == 0 and color or Color3.fromRGB(205, 175, 126))
			end end
		end
	end
	return model
end
return Furniture
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Mission</string>
          <string name="Source"><![CDATA[-- Pure mission rules, shared by the server and command-line tests.
local Mission = {}
Mission.stages = {
	{ title = "Retire o lixo", total = 8, tool = "Saco de lixo", action = "Recolher" },
	{ title = "Pinte as paredes", total = 4, tool = "Rolo de pintura", action = "Pintar" },
	{ title = "Decore a casa", total = 3, tool = "Decoração", action = "Decorar" },
}
function Mission.new()
	return { stage = 1, count = 0, cash = 250, xp = 0, completed = false, used = {} }
end
function Mission.apply(state, stage, id)
	if state.completed or stage ~= state.stage or state.used[id] then
		return false
	end
	state.used[id] = true
	state.count += 1
	state.cash += 25
	state.xp += 20
	if state.count == Mission.stages[stage].total then
		state.stage += 1
		state.count = 0
		if state.stage > #Mission.stages then
			state.completed = true
			state.cash += 5000
			state.xp += 300
		end
	end
	return true
end
return Mission
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">ShopRules</string>
          <string name="Source"><![CDATA[local ShopRules = {}
-- Local coordinates relative to the physical shop floor; also used by the UI.
function ShopRules.inside(x, y, z)
	return math.abs(x) <= 26 and y >= 0 and y <= 12 and math.abs(z) <= 18
end
return ShopRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">WorkRules</string>
          <string name="Source"><![CDATA[local WorkRules = {}
WorkRules.duration = { 1.8, 2.4, 1.2 }
function WorkRules.canFinish(started, now, stage)
	local duration = WorkRules.duration[stage]
	return duration ~= nil and type(started) == "number" and now - started >= duration - .18
end
return WorkRules
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="11">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="12">
      <Properties>
        <string name="Name">Game</string>
      </Properties>
      <Item class="Script" referent="13">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Mission = require(ReplicatedStorage.Shared.Mission)
local Decorations = require(ReplicatedStorage.Shared.Decorations)
local Furniture = require(ReplicatedStorage.Shared.Furniture)
local WorkRules = require(ReplicatedStorage.Shared.WorkRules)
local WorkAnimation = require(script.Parent.WorkAnimation)
local ShopRules = require(ReplicatedStorage.Shared.ShopRules)
local update = Instance.new("RemoteEvent")
update.Name = "RenovationUpdate"
update.Parent = ReplicatedStorage
local shop = Instance.new("RemoteEvent")
shop.Name = "DecorationShop"
shop.Parent = ReplicatedStorage
local sessions = {}
local store = workspace:WaitForChild("Neighborhood"):WaitForChild("Loja")
local function atStore(player)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then return false end
	local position = store.Piso.CFrame:PointToObjectSpace(root.Position)
	return ShopRules.inside(position.X, position.Y, position.Z)
end
local lots = workspace:WaitForChild("Neighborhood"):WaitForChild("Casas")
local available = {}
local originals = {}
for i = 1, 8 do
	local house = lots:WaitForChild("Casa" .. i)
	available[i] = house
	originals[i] = house:Clone()
end

local function send(player, message)
	local session = sessions[player]
	if not session then return end
	local s = session.state
	player:SetAttribute("Cash", s.cash)
	player:SetAttribute("XP", s.xp)
	player:SetAttribute("Stage", s.stage)
	player:SetAttribute("Progress", s.count)
	player:SetAttribute("Completed", s.completed)
	update:FireClient(player, message or "", session.decor)
end
shop.OnServerEvent:Connect(function(player, action, id, color)
	local session = sessions[player]
	if not session or type(action) ~= "string" then return end
	local now = os.clock()
	if now - (session.lastShop or 0) < .15 then return end
	session.lastShop = now
	local message = ""
	if action == "Buy" and type(id) == "string" then
		if not atStore(player) then send(player, "Para comprar, visite a loja Casa & Cia no fim da rua."); return end
		local _, result = Decorations.buy(session.state, session.decor, id)
		message = result
	elseif action == "Select" and type(id) == "string" and type(color) == "string" then
		local _, result = Decorations.select(session.decor, id, color)
		message = result
	elseif action ~= "Sync" then return end
	send(player, message)
end)
local function createHouse(player)
	local slot, model
	for i = 1, 8 do
		if available[i] then slot, model = i, available[i]; break end
	end
	if not model then
		player:Kick("O bairro está cheio. Entre em outro servidor para ter sua casa.")
		return
	end
	available[slot] = nil
	model.Name = "Casa de " .. player.Name
	local state = Mission.new()
	local marker = model:FindFirstChild("SpawnMarker")
	local session = { state = state, decor = Decorations.new(), house = model, slot = slot, spawn = marker.Position, busy = false }
	sessions[player] = session
	local walls = {}
	for i = 1, 4 do walls[i] = model:FindFirstChild("Paint" .. i) end
	local prompts = {}
	local function stopWork()
		if session.work then session.work.animation.stop(); session.work = nil end
	end
	local function refresh()
		for _, item in prompts do
			item.prompt.Enabled = if item.stage == 3 then state.stage >= 3 else not state.completed and item.stage == state.stage and not state.used[item.id]
		end
	end
	local function interactive(target, stage, id, position, onDone, decorSlot)
		local anchor = Instance.new("Attachment", target)
		anchor.Position = position or Vector3.zero
		local prompt = Instance.new("ProximityPrompt", anchor)
		prompt.ActionText = stage == 3 and "Colocar / trocar decoração" or Mission.stages[stage].action
		prompt.ObjectText = Mission.stages[stage].title
		prompt.HoldDuration = WorkRules.duration[stage]
		prompt:SetAttribute("WorkStage", stage)
		prompt:SetAttribute("OwnerUserId", player.UserId)
		prompt.RequiresLineOfSight = false
		prompt.MaxActivationDistance = stage == 3 and 8 or 6
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		table.insert(prompts, { prompt = prompt, stage = stage, id = id })
		prompt.PromptButtonHoldBegan:Connect(function(actor)
			if actor ~= player or session.busy then return end
			if stage == 3 then
				if state.stage < 3 then return end
			elseif state.stage ~= stage or state.used[id] then return end
			local root = actor.Character and actor.Character:FindFirstChild("HumanoidRootPart")
			if not root or (root.Position - anchor.WorldPosition).Magnitude > prompt.MaxActivationDistance + 1 then return end
			stopWork()
			local animation = WorkAnimation.start(actor, stage, anchor)
			if animation then session.work = { animation = animation, prompt = prompt, started = os.clock() } end
		end)
		prompt.PromptButtonHoldEnded:Connect(function(actor)
			if actor ~= player then return end
			local current = session.work
			task.delay(.2, function() if current and session.work == current then stopWork() end end)
		end)
		prompt.Triggered:Connect(function(actor)
			if actor ~= player or session.busy then return end
			local root = actor.Character and actor.Character:FindFirstChild("HumanoidRootPart")
			if not root or (root.Position - anchor.WorldPosition).Magnitude > prompt.MaxActivationDistance + 1 then return end
			local work = session.work
			if not work or work.prompt ~= prompt or work.animation.stopped or not WorkRules.canFinish(work.started, os.clock(), stage) then return end
			stopWork()
			session.busy = true
			if decorSlot then
				local ok, message = Decorations.place(state, session.decor, decorSlot)
				if ok then
					onDone()
					local wasCompleted = state.completed
					local rewarded = Mission.apply(state, stage, id)
					if not wasCompleted and state.completed then message = "Casa reformada! +5.000 e +300 XP"
					elseif rewarded then message ..= " +25 moedas · +20 XP" end
					refresh()
				end
				send(player, message)
				session.busy = false
				return
			end
			if Mission.apply(state, stage, id) then
				onDone()
				refresh()
				send(player, state.completed and "Casa reformada! +5.000 e +300 XP" or "+25 moedas · +20 XP")
			end
			session.busy = false
		end)
	end
	for i = 1, 8 do
		local trash = model:FindFirstChild("Trash" .. i)
		interactive(trash, 1, "trash" .. i, nil, function()
			trash.Transparency = 1
			trash.CanCollide = false
			for _, debris in trash:GetDescendants() do
				if debris:IsA("BasePart") then debris.Transparency = 1; debris.CanCollide = false end
			end
		end)
	end
	local positions = {Vector3.new(0, 1.3, 1), Vector3.new(1, 1.3, 0), Vector3.new(-1, 1.3, 0), Vector3.new(0, 1.3, -1)}
	for i, wall in walls do
		interactive(wall, 2, "wall" .. i, positions[i], function()
			wall.Color = Color3.fromRGB(218, 211, 196)
			local surfaces = model:FindFirstChild("PaintGroup" .. i)
			if surfaces then for _, surface in surfaces:GetChildren() do surface.Color = wall.Color end end
		end)
	end
	for i = 1, 3 do
		local decoration = model:FindFirstChild("Decor" .. i)
		interactive(decoration, 3, "decor" .. i, nil, function()
			local existing = model:FindFirstChild("Furniture" .. i)
			if existing then existing:Destroy() end
			local chosen = session.decor.slots[i]
			local floor = model.Piso
			local base = CFrame.new(decoration.Position.X, floor.Position.Y + floor.Size.Y / 2 + .02, decoration.Position.Z) * floor.CFrame.Rotation
			local furnishing = Furniture.create(chosen.id, chosen.color, base)
			furnishing.Name, furnishing.Parent = "Furniture" .. i, model
			decoration.Transparency = .88
		end, i)
	end
	refresh()
	send(player)
	local function spawnCharacter(character)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root and sessions[player] == session then
			character:PivotTo(CFrame.lookAt(session.spawn, model.Piso.Position + Vector3.new(0, 3, 0)))
		end
	end
	player.CharacterRemoving:Connect(stopWork)
	player.CharacterAdded:Connect(spawnCharacter)
	if player.Character then task.spawn(spawnCharacter, player.Character) end
end
Players.PlayerAdded:Connect(createHouse)
for _, player in Players:GetPlayers() do task.spawn(createHouse, player) end
Players.PlayerRemoving:Connect(function(player)
	local session = sessions[player]
	if session then
		if session.work then session.work.animation.stop() end
		session.house:Destroy()
		local replacement = originals[session.slot]:Clone()
		replacement.Parent = lots
		available[session.slot] = replacement
		sessions[player] = nil
	end
end)

local counterPrompt = Instance.new("ProximityPrompt", store.Balcao)
counterPrompt.ActionText, counterPrompt.ObjectText = "Ver móveis e decorações", "Casa & Cia · Loja de decoração"
counterPrompt.HoldDuration, counterPrompt.MaxActivationDistance = .3, 10
counterPrompt.RequiresLineOfSight = false
counterPrompt.Triggered:Connect(function(player)
	if sessions[player] and atStore(player) then shop:FireClient(player, "Open") end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">WorkAnimation</string>
          <string name="Source"><![CDATA[-- Procedural work gestures. No uploaded animation IDs or asset permissions needed.
-- Animate C0 on the server so observers also see the working character.
local TweenService = game:GetService("TweenService")
local WorkAnimation = {}
function WorkAnimation.start(player, stage, target)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local hand = character and (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm"))
	if not humanoid or humanoid.Health <= 0 or not hand then return nil end
	local handle = { stopped = false, joints = {}, tweens = {}, connections = {} }
	local speed = humanoid.WalkSpeed
	local autoRotate = humanoid.AutoRotate
	humanoid.WalkSpeed = math.min(speed, 5)
	humanoid.AutoRotate = false
	local root = character:FindFirstChild("HumanoidRootPart")
	if root then
		local facing = Vector3.new(target.WorldPosition.X, root.Position.Y, target.WorldPosition.Z)
		if (facing - root.Position).Magnitude > .1 then root.CFrame = CFrame.lookAt(root.Position, facing) end
	end
	player:SetAttribute("WorkAction", stage)
	local tool = Instance.new("Model", character)
	tool.Name = "FerramentaDeTrabalho"
	local function piece(name, size, offset, color, material, cylinder)
		local p = Instance.new("Part")
		p.Name, p.Size, p.Color = name, size, color
		p.Material = material or Enum.Material.SmoothPlastic
		p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		p.CanCollide, p.CanTouch, p.CanQuery, p.Massless = false, false, false, true
		p.CFrame = hand.CFrame * offset
		if cylinder then p.Shape = Enum.PartType.Cylinder end
		p.Parent = tool
		local weld = Instance.new("WeldConstraint", p)
		weld.Part0, weld.Part1 = hand, p
		return p
	end
	local wood = Color3.fromRGB(153, 112, 72)
	if stage == 1 then
		piece("Cabo da vassoura", Vector3.new(.13, 2.7, .13), CFrame.new(0, -.4, -.15), wood, Enum.Material.Wood)
		piece("Base da vassoura", Vector3.new(1.3, .18, .45), CFrame.new(0, -1.8, -.15), Color3.fromRGB(94, 107, 97))
		for i = 1, 7 do piece("Cerdas", Vector3.new(.12, .35, .4), CFrame.new(-.6 + i * .15, -2.05, -.15), Color3.fromRGB(189, 158, 105)) end
	elseif stage == 2 then
		piece("Cabo do rolo", Vector3.new(.18, .85, .18), CFrame.new(0, -.25, -.25), Color3.fromRGB(57, 100, 127))
		piece("Haste", Vector3.new(.08, .7, .08), CFrame.new(0, .5, -.25), Color3.fromRGB(153, 157, 160), Enum.Material.Metal)
		piece("Rolo de pintura", Vector3.new(1.4, .5, .5), CFrame.new(.5, .9, -.25), Color3.fromRGB(224, 219, 208), Enum.Material.Fabric, true)
	else
		piece("Caixa de decoração", Vector3.new(1.5, 1.2, 1.3), CFrame.new(0, -.2, -.65), Color3.fromRGB(174, 137, 96), Enum.Material.Wood)
		piece("Fita da caixa", Vector3.new(.2, .03, 1.32), CFrame.new(0, .42, -.65), Color3.fromRGB(215, 193, 152))
	end
	local function pose(motor, x, y, z, sway)
		local base = motor.C0
		table.insert(handle.joints, { motor = motor, base = base })
		local function rotation(ax, az)
			return CFrame.new(base.Position) * CFrame.Angles(math.rad(ax), math.rad(y), math.rad(az)) * base.Rotation
		end
		motor.C0 = rotation(x, z)
		local tween = TweenService:Create(motor, TweenInfo.new(stage == 1 and .3 or .45, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { C0 = rotation(x + sway, z + sway * .35) })
		tween:Play()
		table.insert(handle.tweens, tween)
	end
	for _, motor in character:GetDescendants() do
		if motor:IsA("Motor6D") then
			if motor.Name == "RightShoulder" or motor.Name == "Right Shoulder" then
				pose(motor, stage == 2 and 80 or 30, 0, stage == 1 and 12 or -10, stage == 1 and 20 or 23)
			elseif motor.Name == "RightElbow" then pose(motor, 25, 0, 0, 20)
			elseif motor.Name == "Waist" then pose(motor, stage == 1 and -16 or -4, 0, 0, 4)
			elseif (motor.Name == "LeftShoulder" or motor.Name == "Left Shoulder") and stage == 3 then pose(motor, 45, 0, 15, 8) end
		end
	end
	function handle.stop()
		if handle.stopped then return end
		handle.stopped = true
		for _, tween in handle.tweens do tween:Cancel() end
		for _, saved in handle.joints do if saved.motor.Parent then saved.motor.C0 = saved.base end end
		for _, connection in handle.connections do connection:Disconnect() end
		if humanoid.Parent then humanoid.WalkSpeed = speed; humanoid.AutoRotate = autoRotate end
		player:SetAttribute("WorkAction", nil)
		tool:Destroy()
	end
	table.insert(handle.connections, humanoid.Died:Connect(handle.stop))
	task.spawn(function()
		local start = os.clock()
		while not handle.stopped do
			local root = character:FindFirstChild("HumanoidRootPart")
			if not target.Parent or not root or (root.Position - target.WorldPosition).Magnitude > 11 or os.clock() - start > 8 then handle.stop(); return end
			task.wait(.15)
		end
	end)
	return handle
end
return WorkAnimation
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="15">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">18</float>
      <token name="CameraMode">0</token>
    </Properties>
    <Item class="StarterPlayerScripts" referent="16">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="17">
        <Properties>
          <string name="Name">Interface</string>
        </Properties>
        <Item class="LocalScript" referent="18">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local Mission = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Mission"))
local event = ReplicatedStorage:WaitForChild("RenovationUpdate")
local pink = Color3.fromRGB(241, 103, 205)
local gui = Instance.new("ScreenGui")
gui.Name = "RenovationHUD"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")
local function panel(name, size, position, anchor)
	local frame = Instance.new("Frame", gui)
	frame.Name, frame.Size, frame.Position = name, size, position
	frame.AnchorPoint = anchor or Vector2.zero
	frame.BackgroundColor3 = Color3.fromRGB(19, 20, 30)
	frame.BackgroundTransparency = 0.12
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 14)
	local border = Instance.new("UIStroke", frame)
	border.Color, border.Transparency = Color3.fromRGB(128, 114, 143), 0.5
	return frame
end
local function label(parent, text, pos, size, color)
	local l = Instance.new("TextLabel", parent)
	l.Position, l.Size = pos, size
	l.BackgroundTransparency = 1
	l.Text, l.TextColor3 = text, color or Color3.fromRGB(243, 241, 247)
	l.Font, l.TextSize = Enum.Font.GothamMedium, 16
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextWrapped = true
	return l
end
local profile = panel("Perfil", UDim2.fromOffset(280, 88), UDim2.fromOffset(18, 18))
label(profile, player.DisplayName, UDim2.fromOffset(16, 8), UDim2.fromOffset(250, 28))
local xp = label(profile, "", UDim2.fromOffset(16, 38), UDim2.fromOffset(250, 32), pink)
local wallet = panel("Carteira", UDim2.fromOffset(180, 55), UDim2.new(1, -18, 0, 18), Vector2.new(1, 0))
local cash = label(wallet, "", UDim2.fromOffset(14, 4), UDim2.fromOffset(155, 45), Color3.fromRGB(78, 225, 158))
local mission = panel("Missão", UDim2.fromOffset(280, 172), UDim2.fromOffset(18, 120))
label(mission, "REFORMAR CASA #1", UDim2.fromOffset(16, 10), UDim2.fromOffset(250, 30), pink)
local rows = {}
for i, stage in Mission.stages do
	rows[i] = label(mission, stage.title, UDim2.fromOffset(16, 42 + (i - 1) * 36), UDim2.fromOffset(250, 34))
end
local toolbar = panel("Ferramentas", UDim2.fromOffset(318, 76), UDim2.new(0.5, 0, 1, -18), Vector2.new(0.5, 1))
local slots = {}
for i, name in {"Saco", "Rolo", "Decoração"} do
	slots[i] = label(toolbar, i .. "  " .. name, UDim2.fromOffset(12 + (i - 1) * 102, 10), UDim2.fromOffset(96, 56))
end
local hint = label(gui, "Segure E para limpar e pintar · Mochila [B]\nCompre na Casa & Cia, no fim da rua", UDim2.new(0.5, -170, 1, -152), UDim2.fromOffset(340, 58))
hint.TextXAlignment = Enum.TextXAlignment.Center
player:GetAttributeChangedSignal("WorkAction"):Connect(function()
	local action = player:GetAttribute("WorkAction")
	local names = { "Varrendo e recolhendo o lixo...", "Pintando a parede...", "Colocando decoração..." }
	hint.Text = names[action] and (names[action] .. "\nContinue segurando E · Solte para cancelar") or "Segure E para limpar e pintar · Mochila [B]\nCompre na Casa & Cia, no fim da rua"
end)
local toast = panel("Notificação", UDim2.fromOffset(330, 54), UDim2.new(0.5, 0, 0, 20), Vector2.new(0.5, 0))
toast.Visible = false
local toastText = label(toast, "", UDim2.fromOffset(12, 4), UDim2.fromOffset(306, 46), Color3.fromRGB(78, 225, 158))
local complete = panel("Conclusão", UDim2.fromOffset(340, 230), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
complete.Visible = false
label(complete, "CASA REFORMADA!", UDim2.fromOffset(22, 22), UDim2.fromOffset(300, 46), pink).TextSize = 25
label(complete, "De casa abandonada a um novo lar.\n\nRecompensa: 5.000 moedas + 300 XP", UDim2.fromOffset(22, 78), UDim2.fromOffset(296, 82))
local close = Instance.new("TextButton", complete)
close.Size, close.Position = UDim2.fromOffset(296, 40), UDim2.fromOffset(22, 172)
close.Text, close.Font, close.TextSize = "Continuar explorando", Enum.Font.GothamBold, 16
close.BackgroundColor3, close.TextColor3 = pink, Color3.new(1, 1, 1)
Instance.new("UICorner", close).CornerRadius = UDim.new(0, 12)
close.Activated:Connect(function() complete.Visible = false end)
local function toggleDecorations()
	local shopGui = player.PlayerGui:FindFirstChild("DecorShop")
	local window = shopGui and shopGui:FindFirstChild("Window")
	if window then window:SetAttribute("InventoryMode", true); window.Visible = not window.Visible end
end
local bag = Instance.new("TextButton", gui)
bag.Size, bag.Position = UDim2.fromOffset(140, 38), UDim2.new(1, -158, 1, -62)
bag.Text, bag.BackgroundColor3, bag.TextColor3 = "Mochila [B]", Color3.fromRGB(35, 31, 46), Color3.new(1, 1, 1)
Instance.new("UICorner", bag).CornerRadius = UDim.new(0, 10)
bag.Activated:Connect(toggleDecorations)
UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == Enum.KeyCode.B then toggleDecorations() end
end)
local shownCompletion = false
local function render()
	local stage = player:GetAttribute("Stage") or 1
	local count = player:GetAttribute("Progress") or 0
	local experience = player:GetAttribute("XP") or 0
	xp.Text = "Nível " .. (1 + math.floor(experience / 300)) .. "   •   " .. experience .. " XP"
	cash.Text = "$ " .. (player:GetAttribute("Cash") or 250)
	for i, definition in Mission.stages do
		local progress = i < stage and definition.total or (i == stage and count or 0)
		rows[i].Text = (i < stage and "✓ " or "○ ") .. definition.title .. " (" .. progress .. "/" .. definition.total .. ")"
		rows[i].TextColor3 = i < stage and Color3.fromRGB(78, 225, 158) or Color3.fromRGB(243, 241, 247)
		slots[i].TextColor3 = i == stage and pink or Color3.fromRGB(148, 143, 157)
	end

	if player:GetAttribute("Completed") and not shownCompletion then
		shownCompletion = true
		complete.Visible = true
	end
end
for _, name in {"Stage", "Progress", "Cash", "XP", "Completed"} do player:GetAttributeChangedSignal(name):Connect(render) end
local toastVersion = 0
event.OnClientEvent:Connect(function(message)
	render()
	if message == "" then return end
	toastVersion += 1
	local version = toastVersion
	toastText.Text, toast.Visible = message, true
	task.delay(3, function() if version == toastVersion then toast.Visible = false end end)
end)
-- Compact the side panels on smaller screens without shrinking touch prompts.
local function resize()
	local camera = workspace.CurrentCamera
	if not camera then return end
	local compact = camera.ViewportSize.X < 850
	for _, frame in {profile, wallet, mission} do
		local scale = frame:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", frame)
		scale.Scale = compact and 0.7 or 1
	end
	mission.Position = UDim2.fromOffset(18, compact and 86 or 120)
	bag.Position = UDim2.new(1, -158, 0, compact and 68 or 84)
end
if workspace.CurrentCamera then workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(resize) end
resize()
render()

-- Hide overhead geometry locally when inside a house, keeping the roof in the world.
local houses = workspace:WaitForChild("Neighborhood"):WaitForChild("Casas")
local roofCache = {}
local function cacheHouse(house)
	local floor = house:FindFirstChild("Piso")
	local roof = house:FindFirstChild("Telhado")
	if not floor or not roof then return end
	local parts = roof:GetChildren()
	local porch = house:FindFirstChild("Cobertura varanda")
	if porch then table.insert(parts, porch) end
	roofCache[house] = { floor = floor, parts = parts }
end
for _, house in houses:GetChildren() do cacheHouse(house) end
cacheHouse(workspace.Neighborhood:WaitForChild("Loja"))
houses.ChildAdded:Connect(cacheHouse)
houses.ChildRemoved:Connect(function(house) roofCache[house] = nil end)
local elapsed = 0
game:GetService("RunService").Heartbeat:Connect(function(dt)
	elapsed += dt
	if elapsed < 0.15 then return end
	elapsed = 0
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	for _, entry in roofCache do
		local pos = root and entry.floor.CFrame:PointToObjectSpace(root.Position)
		local inside = pos and math.abs(pos.X) < entry.floor.Size.X / 2 + 3 and math.abs(pos.Z) < entry.floor.Size.Z / 2 + 8 and pos.Y > -4 and pos.Y < 15
		for _, roof in entry.parts do
			if roof:IsA("BasePart") then roof.LocalTransparencyModifier = inside and 1 or 0 end
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="19">
          <Properties>
            <string name="Name">Shop</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(shared:WaitForChild("Catalog"))
local Furniture = require(shared:WaitForChild("Furniture"))
local ShopRules = require(shared:WaitForChild("ShopRules"))
local shopFloor = workspace:WaitForChild("Neighborhood"):WaitForChild("Loja"):WaitForChild("Piso")
local function atStore()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then return false end
	local position = shopFloor.CFrame:PointToObjectSpace(root.Position)
	return ShopRules.inside(position.X, position.Y, position.Z)
end
local remote = ReplicatedStorage:WaitForChild("DecorationShop")
local update = ReplicatedStorage:WaitForChild("RenovationUpdate")
local pink = Color3.fromRGB(241, 103, 205)
local white = Color3.fromRGB(242, 240, 247)
local snapshot = { inventory = {}, slots = {}, selected = "plant", color = "sage" }
local colorId, category, ownedOnly = "sage", "Todos", false
local gui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
gui.Name, gui.ResetOnSpawn, gui.DisplayOrder = "DecorShop", false, 5
local window = Instance.new("Frame", gui)
window.Name, window.Size, window.Position = "Window", UDim2.fromOffset(700, 540), UDim2.fromScale(.5, .5)
window.AnchorPoint, window.BackgroundColor3, window.Visible = Vector2.new(.5, .5), Color3.fromRGB(20, 22, 32), false
Instance.new("UICorner", window).CornerRadius = UDim.new(0, 18)
local scale = Instance.new("UIScale", window)
local function text(parent, value, x, y, w, h, size, color)
	local label = Instance.new("TextLabel", parent)
	label.BackgroundTransparency = 1
	label.Position, label.Size = UDim2.fromOffset(x, y), UDim2.fromOffset(w, h)
	label.Text, label.TextSize, label.TextColor3 = value, size or 14, color or white
	label.Font, label.TextXAlignment, label.TextWrapped = Enum.Font.GothamMedium, Enum.TextXAlignment.Left, true
	return label
end
local function button(parent, value, x, y, w, h, callback)
	local b = Instance.new("TextButton", parent)
	b.Position, b.Size = UDim2.fromOffset(x, y), UDim2.fromOffset(w, h)
	b.Text, b.TextColor3, b.TextSize, b.Font = value, white, 13, Enum.Font.GothamBold
	b.BackgroundColor3 = Color3.fromRGB(51, 44, 65)
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 9)
	b.Activated:Connect(callback)
	return b
end
text(window, "CASA & CIA", 22, 12, 420, 34, 23, pink)
local balance = text(window, "", 460, 14, 172, 30, 17, Color3.fromRGB(80, 224, 162))
button(window, "X", 648, 14, 32, 32, function() window.Visible = false end)
local feedback = text(window, "Compras na loja física, no fim da rua. Escolha itens da mochila em qualquer lugar.", 22, 49, 655, 32)
local mode = button(window, "Ver: catálogo", 22, 87, 158, 30, function() end)
local chosen = text(window, "", 192, 86, 480, 32, 13, pink)
text(window, "Cor:", 22, 125, 48, 30)
local colorButtons = {}
local render
for i, color in Catalog.colors do
	local b = button(window, color.name, 70 + (i - 1) * 114, 125, 106, 30, function()
		colorId = color.id
		render()
	end)
	b.BackgroundColor3 = Color3.fromRGB(table.unpack(color.rgb))
	b.TextColor3 = Color3.fromRGB(24, 27, 34)
	colorButtons[color.id] = b
end
local filters = {}
for i, name in {"Todos", "Móveis", "Plantas", "Luzes", "Tapetes", "Decoração"} do
	filters[name] = button(window, name, 22 + (i - 1) * 109, 166, 102, 28, function()
		category = name
		render()
	end)
end
local list = Instance.new("ScrollingFrame", window)
list.Position, list.Size = UDim2.fromOffset(22, 206), UDim2.fromOffset(656, 262)
list.BackgroundTransparency, list.BorderSizePixel, list.ScrollBarThickness = 1, 0, 5
list.AutomaticCanvasSize, list.CanvasSize = Enum.AutomaticSize.Y, UDim2.new()
local grid = Instance.new("UIGridLayout", list)
grid.CellSize, grid.CellPadding = UDim2.fromOffset(320, 126), UDim2.fromOffset(10, 10)
grid.SortOrder = Enum.SortOrder.LayoutOrder
local footer = text(window, "3 plantas de presente! Colocação liberada após limpar e pintar.\nTrocar um móvel devolve o anterior à mochila. Progresso válido nesta sessão.", 22, 480, 656, 46, 13, Color3.fromRGB(181, 176, 193))
local function preview(parent, id)
	local viewport = Instance.new("ViewportFrame", parent)
	viewport.Position, viewport.Size = UDim2.fromOffset(8, 12), UDim2.fromOffset(86, 102)
	viewport.BackgroundColor3 = Color3.fromRGB(43, 46, 58)
	Instance.new("UICorner", viewport).CornerRadius = UDim.new(0, 10)
	viewport.Ambient, viewport.LightColor = Color3.fromRGB(190, 190, 200), Color3.fromRGB(255, 238, 220)
	local world = Instance.new("WorldModel", viewport)
	local furniture = Furniture.create(id, colorId, CFrame.new())
	furniture.Parent = world
	local cf, size = furniture:GetBoundingBox()
	local camera = Instance.new("Camera", viewport)
	camera.FieldOfView = 38
	local distance = math.max(size.X, size.Y, size.Z) * 2
	camera.CFrame = CFrame.lookAt(cf.Position + Vector3.new(distance * .7, distance * .45, distance), cf.Position)
	viewport.CurrentCamera = camera
end
render = function()
	local inside = atStore()
	balance.Text = "$ " .. (player:GetAttribute("Cash") or 250)
	local selection = Catalog.find(snapshot.selected)
	chosen.Text = "Ativo: " .. (selection and selection.name or "Planta") .. " · " .. (Catalog.color(snapshot.color) or Catalog.colors[1]).name
	mode.Text = ownedOnly and "Ver: minha mochila" or "Ver: catálogo"
	for name, b in filters do b.BackgroundColor3 = name == category and Color3.fromRGB(137, 61, 124) or Color3.fromRGB(51, 44, 65) end
	for id, b in colorButtons do b.Text = (id == colorId and "✓ " or "") .. Catalog.color(id).name end
	for _, child in list:GetChildren() do if child:IsA("Frame") then child:Destroy() end end
	local visible = 0
	for index, item in Catalog.items do
		local count = snapshot.inventory[item.id] or 0
		local placed = 0
		for _, slot in snapshot.slots do if slot.id == item.id then placed += 1 end end
		if category ~= "Todos" and category ~= item.category then continue end
		if ownedOnly and count == 0 and placed == 0 then continue end
		visible += 1
		local card = Instance.new("Frame", list)
		card.LayoutOrder, card.BackgroundColor3 = index, Color3.fromRGB(30, 33, 46)
		Instance.new("UICorner", card).CornerRadius = UDim.new(0, 12)
		preview(card, item.id)
		text(card, item.name, 104, 8, 208, 31, 14)
		text(card, item.category .. " · $ " .. item.price, 104, 39, 208, 20, 13, pink)
		text(card, "Mochila: " .. count .. " · Na casa: " .. placed, 104, 62, 208, 20, 12)
		local buy = button(card, inside and "Comprar" or "Ir à loja", 104, 89, 96, 28, function()
			if atStore() then remote:FireServer("Buy", item.id)
			else feedback.Text = "Siga a rua até a Casa & Cia. Entre pela vitrine e vá ao balcão para comprar." end
		end)
		buy.BackgroundColor3 = inside and (player:GetAttribute("Cash") or 0) >= item.price and Color3.fromRGB(49, 104, 86) or Color3.fromRGB(63, 62, 69)
		local selectButton = button(card, "Escolher", 208, 89, 103, 28, function() remote:FireServer("Select", item.id, colorId) end)
		selectButton.BackgroundColor3 = snapshot.selected == item.id and Color3.fromRGB(137, 61, 124) or Color3.fromRGB(51, 44, 65)
	end
	footer.Text = visible == 0 and "Nenhum item neste filtro. Abra o catálogo ou escolha outra categoria." or "3 plantas de presente! Após limpar e pintar, segure E nos pontos rosa.\nTrocas devolvem o móvel anterior à mochila. Itens e moedas duram esta sessão."
end
mode.Activated:Connect(function() ownedOnly = not ownedOnly; render() end)
window:GetAttributeChangedSignal("InventoryMode"):Connect(function()
	ownedOnly = window:GetAttribute("InventoryMode") == true
	render()
end)
local function openCatalog()
	window:SetAttribute("InventoryMode", false)
	ownedOnly = false
	window.Visible = not window.Visible
	render()
end
local open = button(gui, "Casa & Cia [L]", 0, 0, 140, 38, openCatalog)
open.Position = UDim2.new(1, -158, 0, 128)
UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == Enum.KeyCode.L then openCatalog() end
end)
remote.OnClientEvent:Connect(function(action)
	if action == "Open" then
		ownedOnly = false
		window:SetAttribute("InventoryMode", false)
		window.Visible = true
		feedback.Text = "Bem-vindo à Casa & Cia! Escolha o móvel e sua cor."
		render()
	end
end)
update.OnClientEvent:Connect(function(message, decor)
	if decor then snapshot = decor; render() end
	if message and message ~= "" then feedback.Text = message end
end)
player:GetAttributeChangedSignal("Cash"):Connect(function() if window.Visible then render() end end)
window:GetPropertyChangedSignal("Visible"):Connect(function() if window.Visible then render(); remote:FireServer("Sync") end end)
local function resize()
	local camera = workspace.CurrentCamera
	if camera then scale.Scale = math.min(1, (camera.ViewportSize.X - 20) / 700, (camera.ViewportSize.Y - 20) / 540) end
end
if workspace.CurrentCamera then workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(resize) end
resize()
render()
remote:FireServer("Sync")
local lastInside = atStore()
task.spawn(function()
	while gui.Parent do
		task.wait(.5)
		local inside = atStore()
		if inside ~= lastInside then lastInside = inside; if window.Visible then render() end end
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
