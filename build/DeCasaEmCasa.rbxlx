      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Mission</string>
          <string name="Source"><![CDATA[-- Pure mission rules, shared by the server and command-line tests.
local Mission = {}
Mission.stages = {
	{ title = "Retire o lixo", total = 8, tool = "Saco de lixo", action = "Recolher" },
	{ title = "Pinte as paredes", total = 4, tool = "Rolo de pintura", action = "Pintar" },
	{ title = "Decore a casa", total = 3, tool = "Decoração", action = "Decorar" },
}
function Mission.new()
	return { stage = 1, count = 0, cash = 250, xp = 0, completed = false, used = {} }
end
function Mission.apply(state, stage, id)
	if state.completed or stage ~= state.stage or state.used[id] then
		return false
	end
	state.used[id] = true
	state.count += 1
	state.cash += 25
	state.xp += 20
	if state.count == Mission.stages[stage].total then
		state.stage += 1
		state.count = 0
		if state.stage > #Mission.stages then
			state.completed = true
			state.cash += 5000
			state.xp += 300
		end
	end
	return true
end
return Mission
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="4">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="5">
      <Properties>
        <string name="Name">Game</string>
      </Properties>
      <Item class="Script" referent="6">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Mission = require(ReplicatedStorage.Shared.Mission)
local update = Instance.new("RemoteEvent")
update.Name = "RenovationUpdate"
update.Parent = ReplicatedStorage
local sessions = {}
local lots = Instance.new("Folder", workspace)
lots.Name = "Casas"
local nextLot = 0

local function part(parent, name, size, position, color, material)
	local p = Instance.new("Part")
	p.Name, p.Size, p.Position = name, size, position
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end
local function send(player, message)
	local session = sessions[player]
	if not session then return end
	local s = session.state
	player:SetAttribute("Cash", s.cash)
	player:SetAttribute("XP", s.xp)
	player:SetAttribute("Stage", s.stage)
	player:SetAttribute("Progress", s.count)
	player:SetAttribute("Completed", s.completed)
	update:FireClient(player, message or "")
end
local function createHouse(player)
	nextLot += 1
	local offset = Vector3.new((nextLot - 1) * 90, 0, 0)
	local model = Instance.new("Model", lots)
	model.Name = "Casa de " .. player.Name
	local state = Mission.new()
	local session = { state = state, house = model, spawn = offset + Vector3.new(0, 4, 23), busy = false }
	sessions[player] = session
	local function make(name, size, pos, color, material)
		return part(model, name, size, offset + pos, color, material)
	end
	make("Jardim", Vector3.new(65, 1, 65), Vector3.new(0, -1, 0), Color3.fromRGB(82, 117, 79), Enum.Material.Grass)
	make("Caminho", Vector3.new(7, 0.2, 15), Vector3.new(0, -0.35, 22), Color3.fromRGB(158, 149, 142), Enum.Material.Cobblestone)
	make("Piso", Vector3.new(30, 1, 26), Vector3.zero, Color3.fromRGB(114, 84, 66), Enum.Material.WoodPlanks)
	-- Open roof lets the camera see the interior; a doorway opens onto the garden.
	local dirty = Color3.fromRGB(117, 106, 91)
	local walls = {
		make("Parede traseira", Vector3.new(30, 11, 0.6), Vector3.new(0, 6, -13), dirty, Enum.Material.Concrete),
		make("Parede esquerda", Vector3.new(0.6, 11, 26), Vector3.new(-15, 6, 0), dirty, Enum.Material.Concrete),
		make("Parede direita", Vector3.new(0.6, 11, 26), Vector3.new(15, 6, 0), dirty, Enum.Material.Concrete),
		make("Fachada", Vector3.new(11, 11, 0.6), Vector3.new(-9.5, 6, 13), dirty, Enum.Material.Concrete),
	}
	make("Fachada direita", Vector3.new(11, 11, 0.6), Vector3.new(9.5, 6, 13), Color3.fromRGB(210, 204, 192))
	make("Viga da entrada", Vector3.new(8, 3, 0.6), Vector3.new(0, 10, 13), Color3.fromRGB(210, 204, 192))
	for _, x in {-9, 9} do
		local window = make("Janela", Vector3.new(5, 5, 0.2), Vector3.new(x, 6.5, -12.6), Color3.fromRGB(162, 207, 220), Enum.Material.Glass)
		window.Transparency = 0.25
	end
	local sign = make("Placa", Vector3.new(10, 2, 0.4), Vector3.new(0, 11, 13.4), Color3.fromRGB(31, 28, 40))
	local surface = Instance.new("SurfaceGui", sign)
	surface.Face = Enum.NormalId.Back
	local title = Instance.new("TextLabel", surface)
	title.Size = UDim2.fromScale(1, 1)
	title.BackgroundTransparency = 1
	title.Text, title.TextScaled = "DE CASA EM CASA", true
	title.TextColor3 = Color3.fromRGB(245, 144, 221)
	title.Font = Enum.Font.GothamBold
	local prompts = {}
	local function refresh()
		for _, item in prompts do
			item.prompt.Enabled = not state.completed and item.stage == state.stage and not state.used[item.id]
		end
	end
	local function interactive(target, stage, id, position, onDone)
		local anchor = Instance.new("Attachment", target)
		anchor.Position = position or Vector3.zero
		local prompt = Instance.new("ProximityPrompt", anchor)
		prompt.ActionText = Mission.stages[stage].action
		prompt.ObjectText = Mission.stages[stage].title
		prompt.HoldDuration = stage == 1 and 0.5 or 1.2
		prompt.RequiresLineOfSight = false
		prompt.MaxActivationDistance = 10
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		table.insert(prompts, { prompt = prompt, stage = stage, id = id })
		prompt.Triggered:Connect(function(actor)
			if actor ~= player or session.busy then return end
			local root = actor.Character and actor.Character:FindFirstChild("HumanoidRootPart")
			if not root or (root.Position - anchor.WorldPosition).Magnitude > 12 then return end
			session.busy = true
			if Mission.apply(state, stage, id) then
				onDone()
				refresh()
				send(player, state.completed and "Casa reformada! +5.000 e +300 XP" or "+25 moedas · +20 XP")
			end
			session.busy = false
		end)
	end
	for i = 1, 8 do
		local x = ((i - 1) % 4) * 6 - 9
		local z = math.floor((i - 1) / 4) * 9 - 5
		local trash = make("Lixo " .. i, Vector3.new(2, 1.6, 2), Vector3.new(x, 1.3, z), Color3.fromRGB(66, 61, 59), Enum.Material.Slate)
		trash.Orientation = Vector3.new(0, i * 27, 0)
		interactive(trash, 1, "trash" .. i, nil, function() trash.Transparency = 1; trash.CanCollide = false end)
	end
	local positions = {Vector3.new(0, -3, 0.8), Vector3.new(0.8, -3, 0), Vector3.new(-0.8, -3, 0), Vector3.new(0, -3, -0.8)}
	for i, wall in walls do
		interactive(wall, 2, "wall" .. i, positions[i], function() wall.Color = Color3.fromRGB(219, 192, 210) end)
	end
	for i, position in {Vector3.new(-9, 2, -8), Vector3.new(9, 2, -8), Vector3.new(9, 2, 7)} do
		local item = make("Decoração " .. i, Vector3.new(3, 3, 3), position, Color3.fromRGB(231, 137, 212))
		item.Transparency, item.CanCollide = 0.7, false
		interactive(item, 3, "decor" .. i, nil, function()
			item.Transparency, item.CanCollide = 0, true
			item.Material = Enum.Material.Wood
			item.Color = Color3.fromRGB(105, 151, 119)
			make("Folhagem", Vector3.new(3.6, 2, 3.6), position + Vector3.new(0, 2.2, 0), Color3.fromRGB(71, 124, 83), Enum.Material.Grass).Shape = Enum.PartType.Ball
		end)
	end
	refresh()
	send(player)
	local function spawnCharacter(character)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root then character:PivotTo(CFrame.new(session.spawn)) end
	end
	player.CharacterAdded:Connect(spawnCharacter)
	if player.Character then task.spawn(spawnCharacter, player.Character) end
end
Players.PlayerAdded:Connect(createHouse)
for _, player in Players:GetPlayers() do task.spawn(createHouse, player) end
Players.PlayerRemoving:Connect(function(player)
	local session = sessions[player]
	if session then session.house:Destroy(); sessions[player] = nil end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="7">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">18</float>
      <token name="CameraMode">0</token>
    </Properties>
    <Item class="StarterPlayerScripts" referent="8">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="9">
        <Properties>
          <string name="Name">Interface</string>
        </Properties>
        <Item class="LocalScript" referent="10">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local Mission = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Mission"))
local event = ReplicatedStorage:WaitForChild("RenovationUpdate")
local pink = Color3.fromRGB(241, 103, 205)
local gui = Instance.new("ScreenGui")
gui.Name = "RenovationHUD"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")
local function panel(name, size, position, anchor)
	local frame = Instance.new("Frame", gui)
	frame.Name, frame.Size, frame.Position = name, size, position
	frame.AnchorPoint = anchor or Vector2.zero
	frame.BackgroundColor3 = Color3.fromRGB(19, 20, 30)
	frame.BackgroundTransparency = 0.12
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 14)
	local border = Instance.new("UIStroke", frame)
	border.Color, border.Transparency = Color3.fromRGB(128, 114, 143), 0.5
	return frame
end
local function label(parent, text, pos, size, color)
	local l = Instance.new("TextLabel", parent)
	l.Position, l.Size = pos, size
	l.BackgroundTransparency = 1
	l.Text, l.TextColor3 = text, color or Color3.fromRGB(243, 241, 247)
	l.Font, l.TextSize = Enum.Font.GothamMedium, 16
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextWrapped = true
	return l
end
local profile = panel("Perfil", UDim2.fromOffset(280, 88), UDim2.fromOffset(18, 18))
label(profile, player.DisplayName, UDim2.fromOffset(16, 8), UDim2.fromOffset(250, 28))
local xp = label(profile, "", UDim2.fromOffset(16, 38), UDim2.fromOffset(250, 32), pink)
local wallet = panel("Carteira", UDim2.fromOffset(180, 55), UDim2.new(1, -18, 0, 18), Vector2.new(1, 0))
local cash = label(wallet, "", UDim2.fromOffset(14, 4), UDim2.fromOffset(155, 45), Color3.fromRGB(78, 225, 158))
local mission = panel("Missão", UDim2.fromOffset(280, 172), UDim2.fromOffset(18, 120))
label(mission, "REFORMAR CASA #1", UDim2.fromOffset(16, 10), UDim2.fromOffset(250, 30), pink)
local rows = {}
for i, stage in Mission.stages do
	rows[i] = label(mission, stage.title, UDim2.fromOffset(16, 42 + (i - 1) * 36), UDim2.fromOffset(250, 34))
end
local toolbar = panel("Ferramentas", UDim2.fromOffset(318, 76), UDim2.new(0.5, 0, 1, -18), Vector2.new(0.5, 1))
local slots = {}
for i, name in {"Saco", "Rolo", "Decoração"} do
	slots[i] = label(toolbar, i .. "  " .. name, UDim2.fromOffset(12 + (i - 1) * 102, 10), UDim2.fromOffset(96, 56))
end
local hint = label(gui, "Aproxime-se dos objetos e segure E\nNo celular, toque no botão de interação", UDim2.new(0.5, -170, 1, -152), UDim2.fromOffset(340, 58))
hint.TextXAlignment = Enum.TextXAlignment.Center
local toast = panel("Notificação", UDim2.fromOffset(330, 54), UDim2.new(0.5, 0, 0, 20), Vector2.new(0.5, 0))
toast.Visible = false
local toastText = label(toast, "", UDim2.fromOffset(12, 4), UDim2.fromOffset(306, 46), Color3.fromRGB(78, 225, 158))
local complete = panel("Conclusão", UDim2.fromOffset(340, 230), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
complete.Visible = false
label(complete, "CASA REFORMADA!", UDim2.fromOffset(22, 22), UDim2.fromOffset(300, 46), pink).TextSize = 25
label(complete, "De casa abandonada a um novo lar.\n\nRecompensa: 5.000 moedas + 300 XP", UDim2.fromOffset(22, 78), UDim2.fromOffset(296, 82))
local close = Instance.new("TextButton", complete)
close.Size, close.Position = UDim2.fromOffset(296, 40), UDim2.fromOffset(22, 172)
close.Text, close.Font, close.TextSize = "Continuar explorando", Enum.Font.GothamBold, 16
close.BackgroundColor3, close.TextColor3 = pink, Color3.new(1, 1, 1)
Instance.new("UICorner", close).CornerRadius = UDim.new(0, 12)
close.Activated:Connect(function() complete.Visible = false end)
local inventory = panel("Inventário", UDim2.fromOffset(320, 245), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
inventory.Visible = false
label(inventory, "INVENTÁRIO", UDim2.fromOffset(20, 12), UDim2.fromOffset(280, 36), pink)
local tools = label(inventory, "", UDim2.fromOffset(20, 55), UDim2.fromOffset(280, 125))
local bag = Instance.new("TextButton", gui)
bag.Size, bag.Position = UDim2.fromOffset(140, 38), UDim2.new(1, -158, 1, -62)
bag.Text, bag.BackgroundColor3, bag.TextColor3 = "Mochila [B]", Color3.fromRGB(35, 31, 46), Color3.new(1, 1, 1)
Instance.new("UICorner", bag).CornerRadius = UDim.new(0, 10)
bag.Activated:Connect(function() inventory.Visible = not inventory.Visible end)
UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == Enum.KeyCode.B then inventory.Visible = not inventory.Visible end
end)
local shownCompletion = false
local function render()
	local stage = player:GetAttribute("Stage") or 1
	local count = player:GetAttribute("Progress") or 0
	local experience = player:GetAttribute("XP") or 0
	xp.Text = "Nível " .. (1 + math.floor(experience / 300)) .. "   •   " .. experience .. " XP"
	cash.Text = "$ " .. (player:GetAttribute("Cash") or 250)
	for i, definition in Mission.stages do
		local progress = i < stage and definition.total or (i == stage and count or 0)
		rows[i].Text = (i < stage and "✓ " or "○ ") .. definition.title .. " (" .. progress .. "/" .. definition.total .. ")"
		rows[i].TextColor3 = i < stage and Color3.fromRGB(78, 225, 158) or Color3.fromRGB(243, 241, 247)
		slots[i].TextColor3 = i == stage and pink or Color3.fromRGB(148, 143, 157)
	end
	tools.Text = "Ferramentas da reforma:\n\nSaco de lixo · Rolo de pintura · Decoração\n\nAtiva: " .. (Mission.stages[stage] and Mission.stages[stage].tool or "Reforma concluída")
	if player:GetAttribute("Completed") and not shownCompletion then
		shownCompletion = true
		complete.Visible = true
	end
end
for _, name in {"Stage", "Progress", "Cash", "XP", "Completed"} do player:GetAttributeChangedSignal(name):Connect(render) end
local toastVersion = 0
event.OnClientEvent:Connect(function(message)
	render()
	if message == "" then return end
	toastVersion += 1
	local version = toastVersion
	toastText.Text, toast.Visible = message, true
	task.delay(3, function() if version == toastVersion then toast.Visible = false end end)
end)
-- Compact the side panels on smaller screens without shrinking touch prompts.
local function resize()
	local camera = workspace.CurrentCamera
	if not camera then return end
	local compact = camera.ViewportSize.X < 850
	for _, frame in {profile, wallet, mission} do
		local scale = frame:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", frame)
		scale.Scale = compact and 0.7 or 1
	end
	mission.Position = UDim2.fromOffset(18, compact and 86 or 120)
	bag.Position = UDim2.new(1, -158, 0, compact and 68 or 84)
end
if workspace.CurrentCamera then workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(resize) end
resize()
render()
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="11">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="FilteringEnabled">true</bool>
      <bool name="NeedsPivotMigration">false</bool>
